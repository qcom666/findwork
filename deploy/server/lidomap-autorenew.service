[Unit]
Description=Lidomap: напоминания и списания автопродления
After=network.target lidomap.service

[Service]
Type=oneshot
User=lidomap
Group=lidomap
WorkingDirectory=/srv/lidomap/current
EnvironmentFile=/etc/lidomap/env
ExecStart=/usr/local/bin/node node_modules/tsx/dist/cli.mjs scripts/autorenew.ts
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
