# ---------- Базы данных (libSQL). Локально это файлы, на Vercel облачные базы Turso ----------
# Каталог заведений: собирается из ingest/, приложение его только читает.
LEADS_DB_URL=file:data/leads.db
LEADS_DB_AUTH_TOKEN=
# Аккаунты, кредиты, платежи: пишется приложением, не пересобирать.
APP_DB_URL=file:data/app.db
APP_DB_AUTH_TOKEN=

# ---------- Адрес сайта (для возврата после оплаты) ----------
APP_URL=http://localhost:3000

# ---------- Кредиты ----------
SIGNUP_BONUS_CREDITS=10
# Награда пригласившему за первую покупку приглашённого (0 выключает)
REFERRAL_REWARD_CREDITS=10

# ---------- ЮKassa. Без ключей локально включается тестовая оплата кнопкой, в продакшене оплаты нет ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ через ЮKassa: нужен ИП и ООО с включёнными «Чеками от ЮKassa». Самозанятым не нужен.
YOOKASSA_RECEIPT=0
YOOKASSA_VAT_CODE=1
# YOOKASSA_TAX_SYSTEM=
# Принимать вебхуки только с IP ЮKassa (дополнительно к сверке статуса через API).
YOOKASSA_ENFORCE_IP=0

# ---------- Реквизиты продавца для оферты ----------
SELLER_NAME=
SELLER_INN=
SUPPORT_EMAIL=
# По умолчанию самозанятый. Для ИП или ООО задайте статус, ОГРН и адрес: оферта перейдёт на чек по 54-ФЗ.
# SELLER_STATUS=индивидуальный предприниматель
# SELLER_OGRN=
# SELLER_ADDRESS=
# SELLER_PHONE=
# SELLER_TELEGRAM=
# Когда база аккаунтов переедет на территорию РФ, укажите провайдера: политика и согласие заменят абзац о хранении (152-ФЗ, ч. 5 ст. 18).
# PD_RU_HOST=

# ---------- Вход через Telegram (необязательно) ----------
# 1) @BotFather: /newbot, имя бота без @ сюда. 2) @BotFather: /setdomain, домен сайта (без него виджет не заработает).
# 3) Токен бота секретный, хранится только на сервере (Vercel: Settings → Environment Variables).
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# ---------- Питчи от Claude. Без ключа работает шаблонный питч ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
PITCH_HOURLY_LIMIT=60

# ---------- Владелец: кто видит страницу /admin с метриками (e-mail через запятую). Пусто: страницы нет ----------
ADMIN_EMAILS=

# ---------- Почта для сброса пароля (Resend). Без этих двух переменных сброс по почте выключен ----------
RESEND_API_KEY=
EMAIL_FROM=FindWork <noreply@ваш-домен>
